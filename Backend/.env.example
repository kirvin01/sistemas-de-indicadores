# Si DB_USER está vacío se usa Trusted_Connection (Windows Auth)

# SQL Server — HIS / pacientes (solo lectura)
DB_GERESA_NAME=DBGERESA

# SQL Server — indicadores FED (solo lectura)
DB_FED_NAME=DBFED2026

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
