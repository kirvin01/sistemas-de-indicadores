# Copiar a .env y ajustar. No commitear .env

SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQL Server — base de aplicación
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_NAME=DBSISINDICADORE
DB_USER=
