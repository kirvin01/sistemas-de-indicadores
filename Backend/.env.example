# =============================================================================
# Backend — copiar a .env y ajustar. NO commitear .env
#   copy .env.example .env
# =============================================================================

SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- SQL Server (aplicación) ---
# Trusted_Connection: dejar DB_USER vacío (Windows Auth)
# SQL Auth: completar DB_USER y DB_PASSWORD
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_NAME=DBSISINDICADORE
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- SQL Server (solo lectura) ---
DB_GERESA_NAME=DBGERESA
DB_FED_NAME=DBFED2026
DB_NUTRICION_NAME=DBNUTRICION

# --- Auth / CORS / Frontend (links de recuperación) ---
ACCESS_TOKEN_EXPIRE_MINUTES=65
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Correo (recuperación de contraseña) ---
# Desarrollo (default si DEBUG=True): imprime el mail en la consola del runserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Producción / SMTP real (ejemplo Gmail / Office365 / servidor institucional):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario@dominio.gob.pe
# EMAIL_HOST_PASSWORD=********
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@geresa.gob.pe
#
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@geresa.local
PASSWORD_RESET_EXPIRE_MINUTES=30
