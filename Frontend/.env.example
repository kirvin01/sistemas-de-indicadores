# =============================================================================
# Frontend — copiar a .env y ajustar. NO commitear .env
#   copy .env.example .env
# =============================================================================

# URL base de la API Django Ninja (incluye /api)
VITE_API_URL=http://127.0.0.1:8001/api

# Producción (mismo dominio, nginx proxea /api/):
# VITE_API_URL=https://indicadores.diresacusco.gob.pe/api

# Si el backend corre en otra máquina/puerto, ejemplo:
# VITE_API_URL=http://192.168.1.10:8001/api

# Enlace Cloud FED (botón en reportes FED)
VITE_FED_CLOUD_URL=https://cloud.diresacusco.gob.pe/s/2EyoPfEToNgxrne

# Enlace Cloud Nutrición (opcional; si vacío se oculta el botón)
VITE_NUTRICION_CLOUD_URL=https://cloud.diresacusco.gob.pe/s/2rHrGwJRrzprZaD

# Enlace Cloud Convenio de Gestión
VITE_CG_CLOUD_URL=https://cloud.diresacusco.gob.pe/s/2rHrGwJRrzprZaD
